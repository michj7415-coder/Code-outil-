# URL du projet Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique du projet (Project Settings > API Keys > Publishable key,
# ou l'ancienne clé « anon »). Elle est faite pour le navigateur : la sécurité
# repose sur la Row Level Security définie dans supabase/migrations.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL publique de l'application, utilisée dans le lien de confirmation d'email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
